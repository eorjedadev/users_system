# ==============================================================================
# .env.example — Variables de Entorno Opcionales (Entorno de Desarrollo)
# ==============================================================================
# Copie este archivo como '.env' para sobreescribir configuraciones locales
# si fuera necesario en su estación de trabajo.
# NUNCA suba su archivo '.env' real con datos sensibles a GitHub.

# Modo de ejecución (development / production)
APP_ENV=development

# Nivel de detalle de registro en consola (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timeout de concurrencia en base de datos SQLite (en milisegundos)
DB_BUSY_TIMEOUT_MS=5000

# URL base predeterminada de Outlook Web App corporativo
DEFAULT_OWA_URL=https://correo.entelcc.cl/owa
